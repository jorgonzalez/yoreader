<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon foreground: the RSS badge over the matchstick-cube photo
     (drawable-nodpi/ic_launcher_photo). 108dp canvas; the launcher mask shows
     roughly the central 72dp, and the badge stays inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Thin light ring to lift the badge off the photo -->
    <path
        android:fillColor="#F2F2F2"
        android:pathData="M59.8,69 a11.2,11.2 0 1,0 22.4,0 a11.2,11.2 0 1,0 -22.4,0 Z" />
    <path
        android:fillColor="#F78422"
        android:pathData="M60.8,69 a10.2,10.2 0 1,0 20.4,0 a10.2,10.2 0 1,0 -20.4,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M65.6,71.1 a1.7,1.7 0 1,0 3.4,0 a1.7,1.7 0 1,0 -3.4,0 Z" />
    <path
        android:pathData="M65.8,67 A5.6,5.6 0 0 1 71.4,72.6"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M65.8,62.8 A9.8,9.8 0 0 1 75.6,72.6"
        android:strokeWidth="2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
</vector>
