<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: everything is backed up or transferred except the Nostr key. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nostr.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nostr.xml" />
    </device-transfer>
</data-extraction-rules>
